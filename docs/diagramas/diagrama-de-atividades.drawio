        </mxCell>
        <mxCell id="atividade-entrar-c49" value="Modo demonstração: um único botão, sem escolher “com dados” ou “do zero”. Os dados do usuário demo vêm antes do comando python manage.py seed_demo (8 categorias, 240 transações em 12 meses); --reset os recria. Entrar não recria nada." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5862;fontSize=14;fontColor=#142028;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=12;" vertex="1" parent="atividade-entrar-lane6">
