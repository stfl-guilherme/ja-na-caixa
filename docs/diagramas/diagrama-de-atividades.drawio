        <mxCell id="atividade-fixas-c8" value="Clicar em “Repetir fixas de [mês anterior]”" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#142028;strokeWidth=1.5;fontSize=14;fontColor=#142028;spacing=6;" vertex="1" parent="atividade-fixas-lane3">
