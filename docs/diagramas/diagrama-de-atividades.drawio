        <mxCell id="atividade-transacao-c53" value="O tipo escolhido só filtra a lista de categorias: a transação não guarda o tipo, ele vem da categoria (ADR-004). A categoria criada pelo botão (POST /api/categorias/) já vem com o tipo marcado e fica selecionada." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5862;fontSize=14;fontColor=#142028;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=12;" vertex="1" parent="atividade-transacao-lane5">
          <mxGeometry x="70" y="30" width="720" height="110" as="geometry" />
        </mxCell>
        <mxCell id="atividade-transacao-c54" value="Categoria de outro usuário → 400 (fica fora do queryset do campo categoria). Mesmo que a validação falhe, o banco recusa valor ≤ 0 pelo CHECK transacao_valor_positivo." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5862;fontSize=14;fontColor=#142028;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=12;" vertex="1" parent="atividade-transacao-lane6">
