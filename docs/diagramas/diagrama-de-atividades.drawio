        </mxCell>
        <mxCell id="atividade-entrar-c56" value="Demonstração (ADR-018): “exemplo” usa o usuário demo e “vazio” usa demo-vazio. Os dados do modo são recriados a cada entrada (financas/demo.py); sair e entrar de novo apaga o que foi lançado." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5862;fontSize=14;fontColor=#142028;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=12;" vertex="1" parent="atividade-entrar-lane6">
