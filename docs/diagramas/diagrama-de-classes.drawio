        <mxCell id="classes-camadas-c1" value="Camadas do backend — classes reais (backend/financas)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#142028;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1500" height="32" as="geometry" />
