        <mxCell id="atividade-fixas-c2" value="Tela Transações → RepetirFixasDialog (frontend) → GET /api/transacoes/fixas-para-repetir/ e POST /api/transacoes/repetir-fixas/ → TransacaoViewSet." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#4A5862;strokeColor=none;fillColor=none;" vertex="1" parent="1">
