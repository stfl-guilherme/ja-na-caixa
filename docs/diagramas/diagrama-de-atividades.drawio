        <mxCell id="atividade-excluir-e45" value="" style="html=1;rounded=0;endArrow=open;endSize=12;strokeColor=#142028;strokeWidth=1.5;fontSize=14;fontColor=#142028;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="atividade-excluir-c21" target="atividade-excluir-c22">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1760" y="940" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="atividade-excluir-e46" value="" style="html=1;rounded=0;endArrow=open;endSize=12;strokeColor=#142028;strokeWidth=1.5;fontSize=14;fontColor=#142028;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="atividade-excluir-c22" target="atividade-excluir-c23">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="atividade-excluir-c47" value="Com transações, o diálogo só informa: não tem botão de excluir. O 409 do backend garante a regra mesmo se a contagem da tela estiver desatualizada." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5862;fontSize=14;fontColor=#142028;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=12;" vertex="1" parent="atividade-excluir-lane5">
          <mxGeometry x="70" y="30" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="atividade-excluir-c48" value="on_delete=PROTECT: antes do DELETE, o Django procura transações ligadas à categoria e lança ProtectedError; a view responde 409 com a quantidade." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5862;fontSize=14;fontColor=#142028;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=12;" vertex="1" parent="atividade-excluir-lane6">
          <mxGeometry x="70" y="40" width="900" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="atividade-fixas" name="Repetir transações fixas">
