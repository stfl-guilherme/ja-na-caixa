#!/bin/sh
# Bloqueia commits com coautoria ou assinatura do Claude.
# Não bloqueia menções legítimas como "atualizar CLAUDE.md".
if grep -qiE '^co-authored-by:|generated with.*claude|noreply@anthropic\.com' "$1"; then
  echo "ERRO: a mensagem de commit contém coautoria/assinatura do Claude. Remova e tente de novo." >&2
  exit 1
fi
