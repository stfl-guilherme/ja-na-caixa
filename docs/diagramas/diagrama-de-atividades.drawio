        <mxCell id="atividade-entrar-c55" value="Erros: senha incorreta → 400 “Usuário ou senha inválidos”; modo inválido → 400; DEMO_ENABLED=false → 404." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5862;fontSize=14;fontColor=#142028;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=12;" vertex="1" parent="atividade-entrar-lane5">
